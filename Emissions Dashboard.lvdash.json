{
  "datasets": [
    {
      "name": "5789e049",
      "displayName": "Global Carbon Emissions Geographic Coordinates Data",
      "queryLines": [
        "SELECT latitude, \r\n",
        "longitude,\r\n",
        "'GHG emissions mtons CO2e' as Emissions\r\n",
        "FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "9ac60db9",
      "displayName": "Emission per person",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "        population,\r\n",
        "        CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population AS emissions_per_person_mtons_co2e\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "WHERE population > 0\r\n",
        "ORDER BY emissions_per_person_mtons_co2e DESC\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "ebb87763",
      "displayName": "Total Emission Per State",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "        SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE))  AS Total_Emissions\r\n",
        "FROM emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emissions DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "21ef9e21",
      "displayName": "County Shaming",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS Total_Emission\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY Total_Emission DESC\r\n",
        "LIMIT 10    \r\n",
        "       "
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
