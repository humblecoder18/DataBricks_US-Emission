   "source": [
    "SELECT county_state_name,\n",
    "        population,\n",
    "        CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population AS emissions_per_person_mtons_co2e\n",
    "FROM emissions_data\n",
    "WHERE population > 0\n",
    "ORDER BY emissions_per_person_mtons_co2e DESC\n"
   ]
  }
